  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uC5EC\uAE30\uC11C\uC758 \uC7A5\uC0AC\uB294 \uC624\uB298\uC774 \uB9C8\uC9C0\uB9C9\uC774\uB2C8\uAE4C
