  m_Script: {fileID: 11500000, guid: 4c53d81ab5e34a84eb3611792c4104bc, type: 3}
  m_Name: DialogueData Stage1
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uB4DC\uB514\uC5B4 \uAFC8\uC5D0 \uADF8\uB9AC\uB358 \uC57C\uC791\uC2DD\uB2F9\uC744
      \uC5F4\uAC8C\uB410\uC5B4!"
    portrait: {fileID: 822462823, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 5a844a8b858727d408abf7f678fae2aa, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uD558\uC9C0\uB9CC \uBAA8\uC544\uB454 \uB3C8\uC744 \uB2E4 \uC4F0\uAE34
      \uD588\uC9C0\uB9CC \uD558\uD558.."
    portrait: {fileID: -1298983417, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 6e26f5bf9f3fda14bb4b9b9964d0decf, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uADF8\uB798\uB3C4 \uD64D\uBCF4\uB3C4 \uC5F4\uC2EC\uD788 \uD588\uACE0
      \uC190\uB2D8\uB4E4\uC774 \uB9CE\uC774 \uC624\uACA0\uC9C0?"
    portrait: {fileID: -1298983417, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 9c670107753e27c4382ff767cc027958, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uC88B\uC544 \uD798\uB0B4\uBCF4\uC790 \uC544\uC790 \uC544\uC790!"
    portrait: {fileID: 822462823, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 3a11be134f2407440a52aa91f240e0a5, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uC190\uB2D8\uC774 \uC6D0\uD558\uB294 \uBA54\uB274\uB97C \uC8FC\uBC29
      \uAE30\uAD6C\uC5D0\uC11C E\uB97C \uB20C\uB7EC\uC11C \uB9CC\uB4E4\uACE0 \uC190\uB2D8\uD55C\uD14C
      E\uB85C \uC804\uB2EC\uD558\uBA74 \uB3FC!"
    portrait: {fileID: -1298983417, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 75dd6bb6da235164585b84ed36606c3b, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uC798\uBABB \uB9CC\uB4E0 \uC74C\uC2DD\uC740 \uD734\uC9C0\uD1B5\uC5D0\uC11C
      E\uB97C \uB204\uB974\uBA74 \uBC84\uB824\uC838!"
    portrait: {fileID: -1298983417, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 5ee973dc22bc5d641bbc3e0700e24c66, type: 3}
  - speakerName: "\uBBF8\uC2A4\uCE58"
    text: "\uC790 \uADF8\uB7FC \uC2DC\uC791\uD574\uBCF4\uC790!"
    portrait: {fileID: 822462823, guid: d6bd230d06f07c547a5af7fc76970bc2, type: 3}
    voice: {fileID: 8300000, guid: 72ac2190f27394745b39495ba4c308c8, type: 3}
